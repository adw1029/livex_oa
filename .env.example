# cal.com — Settings → Security → API keys (live keys start with cal_live_, test keys with cal_)
CAL_API_KEY=cal_live_xxx

# LLM provider: "anthropic" (default) or "bedrock"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5-5

# Bedrock (used when LLM_PROVIDER=bedrock) — auth comes from your AWS profile, no keys here
AWS_PROFILE=adw
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-sonnet-5-5

# low | medium | high — higher = more careful, slower
LLM_EFFORT=medium
